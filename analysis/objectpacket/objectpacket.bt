// Total Battle Object Packet Template for 010 Editor
// Version: 2.6 - Full object parsing

typedef struct {
    uint32 packetSize;
    uint32 flags;
} HEADER;

HEADER h;
Printf("=== Total Battle Packet v2.6 ===\n\n");
Printf("Packet Size: %d bytes\n\n", h.packetSize);

// Outer fixarray[2]
Printf("Header: 0x%02X (fixarray[2])\n", ReadUByte(FTell()));
FSkip(1);

// View coords
Printf("View Coords:\n");
Printf("  X Type: 0x%02X\n", ReadUByte(FTell()));
LittleEndian(); uint16 viewX; LittleEndian();
Printf("  X: %d\n", viewX);
Printf("  Y Type: 0x%02X\n", ReadUByte(FTell()));
LittleEndian(); uint16 viewY; LittleEndian();
Printf("  Y: %d\n\n", viewY);

// Skip unknown bytes until objects
Printf("Skipping terrain data...\n");
local int pos = 15;
while (pos < FileSize() && !(ReadUByte(pos) == 0x9c && ReadUByte(pos+1) == 0x91 && ReadUByte(pos+2) == 0xcf)) {
    pos++;
}
FSkip(pos - FTell());
Printf("Objects start at offset %d\n\n", FTell());

// Parse objects
Printf("=== Objects ===\n\n");
Printf("%-5s %-6s %-4s %-12s %-15s\n", "Num", "Type", "Lv", "ObjectId", "Coords");
Printf("%-5s %-6s %-4s %-12s %-15s\n", "----", "------", "----", "------------", "---------------");

typedef struct {
    uchar marker1 <comment="0x9c">;
    uchar arr1 <comment="0x91">;
    uchar oid_type <comment="0xcf">;
    LittleEndian(); uint64 objectId; LittleEndian();
    
    uchar sid_type <comment="0xcd">;
    LittleEndian(); ushort staticId; LittleEndian();
    
    uchar unk1;
    uchar unk2;
    uchar unk3;
    uchar level;
    uchar unk5;
    uchar unk6;
    uchar unk7;
    uchar unk8;
    
    uchar coord_type <comment="0x93">;
    uchar kingdom;
    uchar x;
    uchar y;
    
    uchar inner_type <comment="0x91">;
    uchar inner_val;
    
    uchar extra_type <comment="0xce">;
    LittleEndian(); uint extra; LittleEndian();
    
    uchar flag <comment="0xc2/false 0xc3/true">;
} MAP_OBJECT;

local int count = 0;
local int mercs = 0;
local string typeName;

while (FTell() < FileSize() - 33) {
    if (ReadUByte(FTell()) == 0x9c && ReadUByte(FTell()+1) == 0x91 && ReadUByte(FTell()+2) == 0xcf) {
        MAP_OBJECT obj;
        count++;
        
        if (obj.staticId == 400) {
            typeName = "MERC";
            mercs++;
            Printf("%-5d %-6s %-4d %-15Lu k%d,%d,%d\n", 
                count, typeName, obj.level, obj.objectId, obj.kingdom, obj.x, obj.y);
        } else if (obj.staticId >= 1450) {
            typeName = "BUILD";
            Printf("%-5d %-6s %-4d %-15Lu k%d,%d,%d\n", 
                count, typeName, obj.level, obj.objectId, obj.kingdom, obj.x, obj.y);
        } else if (obj.staticId == 512) {
            typeName = "CASTLE";
            Printf("%-5d %-6s %-4d %-15Lu k%d,%d,%d\n", 
                count, typeName, obj.level, obj.objectId, obj.kingdom, obj.x, obj.y);
        } else if (obj.staticId == 133) {
            typeName = "RESRC";
            Printf("%-5d %-6s %-4d %-15Lu k%d,%d,%d\n", 
                count, typeName, obj.level, obj.objectId, obj.kingdom, obj.x, obj.y);
        } else {
            Printf("%-5d ID:%-5d %-4d %-15Lu k%d,%d,%d\n", 
                count, obj.staticId, obj.level, obj.objectId, obj.kingdom, obj.x, obj.y);
        }
    } else {
        uchar skip;
    }
}

Printf("\n=== Summary ===\n");
Printf("Total Objects: %d\n", count);
Printf("Mercenaries:  %d\n", mercs);
Printf("================\n");
